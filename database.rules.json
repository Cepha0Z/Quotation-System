{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && newData.child('role').val() === 'employee'))",
        ".validate": "newData.child('email').isString() && newData.child('displayName').isString() && (newData.child('role').val() === 'employee' || newData.child('role').val() === 'admin')",
        "email": { ".validate": true },
        "displayName": { ".validate": true },
        "role": { ".validate": true },
        "createdAt": { ".validate": true },
        "$other": { ".validate": false }
      }
    },
    "userProjects": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$projectId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && newData.val() === true && !root.child('projectsTechnical').child($projectId).exists() && newData.parent().parent().parent().child('projectsTechnical').child($projectId).child('createdBy').val() === auth.uid))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "projectMembers": {
      "$projectId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$uid": { ".validate": "newData.val() === true" }
      }
    },
    "projectsTechnical": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$projectId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('userProjects').child(auth.uid).child($projectId).val() === true || root.child('projectMembers').child($projectId).child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.exists() && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || root.child('userProjects').child(auth.uid).child($projectId).val() === true || root.child('projectMembers').child($projectId).child(auth.uid).val() === true)))",
        ".validate": "newData.child('id').val() === $projectId && newData.child('createdBy').isString() && (!data.exists() || newData.child('createdBy').val() === data.child('createdBy').val())",
        "id": { ".validate": true },
        "clientName": { ".validate": true },
        "propertyName": { ".validate": true },
        "layout": { ".validate": true },
        "carpetArea": { ".validate": true },
        "status": { ".validate": true },
        "createdAt": { ".validate": true },
        "updatedAt": { ".validate": true },
        "propertyType": { ".validate": true },
        "location": { ".validate": true },
        "notes": { ".validate": true },
        "createdBy": { ".validate": true },
        "floorOrder": { ".validate": true },
        "floors": {
          "$floorId": {
            ".validate": "newData.child('id').val() === $floorId && newData.child('name').isString()",
            "id": { ".validate": true },
            "name": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "roomOrder": { ".validate": true },
        "rooms": {
          "$roomId": {
            ".validate": "newData.child('id').val() === $roomId && newData.child('name').isString()",
            "id": { ".validate": true },
            "name": { ".validate": true },
            "floorId": { ".validate": true },
            "itemOrder": { ".validate": true },
            "items": {
              "$itemId": {
                ".validate": "newData.child('id').val() === $itemId && newData.child('name').isString()",
                "id": { ".validate": true },
                "rateCardId": { ".validate": true },
                "name": { ".validate": true },
                "description": { ".validate": true },
                "measurementType": { ".validate": true },
                "quantity": { ".validate": true },
                "length": { ".validate": true },
                "width": { ".validate": true },
                "height": { ".validate": true },
                "notes": { ".validate": true },
                "workType": { ".validate": true },
                "unit": { ".validate": true },
                "customUnit": { ".validate": true },
                "dimensionUnit": { ".validate": true },
                "hsnCode": { ".validate": true },
                "measureMode": { ".validate": true },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "revisionHistory": {
          "$revisionId": {
            ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('authorName').val() === root.child('users').child(auth.uid).child('displayName').val() && (root.child('userProjects').child(auth.uid).child($projectId).val() === true || root.child('projectMembers').child($projectId).child(auth.uid).val() === true)",
            ".validate": "newData.child('id').val() === $revisionId && newData.child('projectId').val() === $projectId && newData.child('number').isNumber() && newData.child('createdAt').isString() && newData.child('note').isString() && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('authorName').val() === root.child('users').child(auth.uid).child('displayName').val()) || (data.exists() && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('authorName').val() === data.child('authorName').val()))",
            "id": { ".validate": true },
            "projectId": { ".validate": true },
            "number": { ".validate": true },
            "createdAt": { ".validate": true },
            "createdBy": { ".validate": true },
            "authorName": { ".validate": true },
            "note": { ".validate": true },
            "snapshot": {
              ".validate": "newData.child('id').val() === $projectId",
              "id": { ".validate": true },
              "clientName": { ".validate": true },
              "propertyName": { ".validate": true },
              "layout": { ".validate": true },
              "carpetArea": { ".validate": true },
              "status": { ".validate": true },
              "createdAt": { ".validate": true },
              "updatedAt": { ".validate": true },
              "propertyType": { ".validate": true },
              "location": { ".validate": true },
              "notes": { ".validate": true },
              "floorOrder": { ".validate": true },
              "floors": {
                "$floorId": {
                  ".validate": "newData.child('id').val() === $floorId && newData.child('name').isString()",
                  "id": { ".validate": true },
                  "name": { ".validate": true },
                  "$other": { ".validate": false }
                }
              },
              "roomOrder": { ".validate": true },
              "rooms": {
                "$roomId": {
                  ".validate": "newData.child('id').val() === $roomId && newData.child('name').isString()",
                  "id": { ".validate": true },
                  "name": { ".validate": true },
                  "floorId": { ".validate": true },
                  "itemOrder": { ".validate": true },
                  "items": {
                    "$itemId": {
                      ".validate": "newData.child('id').val() === $itemId && newData.child('name').isString()",
                      "id": { ".validate": true },
                      "rateCardId": { ".validate": true },
                      "name": { ".validate": true },
                      "description": { ".validate": true },
                      "measurementType": { ".validate": true },
                      "quantity": { ".validate": true },
                      "length": { ".validate": true },
                      "width": { ".validate": true },
                      "height": { ".validate": true },
                      "notes": { ".validate": true },
                      "workType": { ".validate": true },
                      "unit": { ".validate": true },
                      "customUnit": { ".validate": true },
                      "dimensionUnit": { ".validate": true },
                      "hsnCode": { ".validate": true },
                      "measureMode": { ".validate": true },
                      "$other": { ".validate": false }
                    }
                  },
                  "$other": { ".validate": false }
                }
              },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "projectsFinancial": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "rateCardTechnical": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "rateCardFinancial": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "firmSettings": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "revisions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
